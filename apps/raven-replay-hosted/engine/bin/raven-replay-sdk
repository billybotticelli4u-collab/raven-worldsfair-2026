#!/bin/sh
# Launcher: require exact Node v22.18.0 unless --node is supplied.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
NODE_BIN="${RAVEN_REPLAY_NODE:-node}"
PORTABLE_HINT="See docs/RUNTIME.md for obtaining Node v22.18.0"

while [ $# -gt 0 ]; do
  case "$1" in
    --node)
      NODE_BIN=$2
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [ ! -x "$NODE_BIN" ] && ! command -v "$NODE_BIN" >/dev/null 2>&1; then
  echo "Node executable not found: $NODE_BIN" >&2
  echo "$PORTABLE_HINT" >&2
  exit 3
fi

VER=$("$NODE_BIN" -p "process.version" 2>/dev/null || true)
if [ "$VER" != "v22.18.0" ]; then
  echo "wrong or unreadable Node runtime: want v22.18.0, got ${VER:-unreadable}" >&2
  echo "$PORTABLE_HINT" >&2
  exit 3
fi

exec "$NODE_BIN" "$ROOT/src/cli.mjs" "$@"
