{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd vendor/raven-receipt-verifier/packages/verify-js && npm install",
  "buildCommand": "cd vendor/raven-receipt-verifier/packages/verify-js && npm run build && cd ../../../../apps/worldsfair-agent-trust && node src/write-build-info.js",
  "outputDirectory": "apps/worldsfair-agent-trust/public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "{apps/worldsfair-agent-trust/**,vendor/raven-receipt-verifier/packages/verify-js/dist/**,vendor/raven-receipt-verifier/packages/verify-js/package.json}"
    }
  }
}
